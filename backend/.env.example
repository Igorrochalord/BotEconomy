# Telegram (used to push daily summaries and alert notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated list of origins allowed to call this API.
# For the Chrome extension use its extension origin, e.g.:
# chrome-extension://<your-extension-id>
ALLOWED_ORIGINS=*

# Optional shared secret required (as header X-API-Key) for write endpoints
# (add/remove tickers, create/delete alerts). Leave empty to disable.
BOTECONOMY_API_KEY=

PORT=8000
MORNING_SUMMARY_HOUR=6
EVENING_SUMMARY_HOUR=20
ALERT_CHECK_MINUTES=15
